<resources>
    <!-- Always light: the app draws its own "Fresh" theme (see ui/Theme.kt). -->
    <style name="Theme.ActionTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- WidgetRefreshActivity: no window, no animation, no dimming. -->
    <style name="Theme.ActionTracker.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
